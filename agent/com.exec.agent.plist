<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.exec.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>source /Users/rock/ai/projects/exec/agent/.env.sh &amp;&amp; /Users/rock/.bun/bin/bun run /Users/rock/ai/projects/exec/agent/index.ts</string>
